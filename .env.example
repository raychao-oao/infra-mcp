# Database
DATABASE_URL=sqlite:///./configs/resources.db

# Server
# Bind to 127.0.0.1 (localhost only) — access via Cloudflare Tunnel or reverse proxy
# Change to 0.0.0.0 only if you handle auth at the network layer
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Infrastructure — VPS Servers
# Comma-separated list of SSH host aliases (must match ~/.ssh/config)
INFRA_SERVERS=prod,staging
INFRA_DEFAULT_SERVER=prod
INFRA_DNS_SERVER=prod

# Infrastructure — Domain
# Domain where this MCP server is hosted (used for CORS)
INFRA_DOMAIN=infra.your-domain.com

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# VPS SSH
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_USER=your_username

# Gitea (optional — only needed if using Gitea repo management tools)
GITEA_API_URL=http://your-gitea-host:3000/api/v1
GITEA_BASE_URL=https://git.your-domain.com
GITEA_API_TOKEN=your_gitea_api_token
GITEA_DANGER_TOKEN=your_danger_token_for_destructive_operations
# Comma-separated repo names that cannot be deleted (e.g., infra-mcp,services)
# GITEA_PROTECTED_REPOS=infra-mcp,services

# Cloudflare Tunnel → Server tunnel name map (optional)
# Format: server_alias:tunnel_name,server_alias2:tunnel_name2
# Defaults to {server}-main convention (e.g., prod → prod-main) if not set
# SERVER_TUNNEL_MAP=prod:prod-main,staging:staging-main

# Local server detection
# Set to the SSH alias of the machine running this server.
# When INFRA_LOCAL_SERVER matches a target server, commands run locally instead of via SSH.
INFRA_LOCAL_SERVER=prod

# Cloudflare Access Service Token (for client usage)
# For CLIENT: Set in ~/.zshrc — not here
# For SERVER: Optional
# CF_ACCESS_CLIENT_ID=your_service_token_client_id.access
# CF_ACCESS_CLIENT_SECRET=your_service_token_client_secret
