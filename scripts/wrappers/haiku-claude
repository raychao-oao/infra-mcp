#!/bin/bash
# Wrapper for Claude Haiku 4.5 model
# 檔案路徑：template/scripts/wrappers/haiku-claude
# 版本：v1.0
# 更新：2025-10-16

# Load NVM environment
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Execute claude with haiku model
if [ -n "$AI_LOG_FILE" ]; then
    claude --model haiku "$@" | tee -a "$AI_LOG_FILE"
else
    claude --model haiku "$@"
fi
