#!/bin/bash
#
# Gemini Wrapper Script for Claude Code (v6.0)
#
# Purpose: Load NVM environment and execute gemini CLI
# Usage: gemini-claude "your gemini query"
#

# Load NVM environment
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Execute gemini with all arguments
# 自動日誌記錄（v6.0 新增）
if [ -n "$AI_LOG_FILE" ]; then
    gemini "$@" | tee -a "$AI_LOG_FILE"
else
    gemini "$@"
fi
