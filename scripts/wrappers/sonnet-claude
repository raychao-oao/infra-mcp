#!/bin/bash
#
# Sonnet Wrapper Script for Claude Code (v6.0)
#
# Purpose: Load NVM environment and execute claude CLI with Sonnet model
# Usage: sonnet-claude -p "your query"
#

# Load NVM environment
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Execute claude with sonnet model and all arguments
# 自動日誌記錄（v6.0 新增）
if [ -n "$AI_LOG_FILE" ]; then
    claude --model sonnet "$@" | tee -a "$AI_LOG_FILE"
else
    claude --model sonnet "$@"
fi
